<?xml version="1.0"?>
<ruleset>
    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>
    <arg name="cache" value=".phpcs-cache"/>
    <arg name="colors"/>
    <arg value="nps"/>

    <file>src</file>
    <file>tests</file>
    <exclude-pattern>tests/Smoke/symfony-app/var/*</exclude-pattern>
    <exclude-pattern>tests/Smoke/symfony-app/vendor/*</exclude-pattern>
    <exclude-pattern>tests/Smoke/symfony-app/config/reference.php</exclude-pattern>

    <rule ref="Doctrine"/>
</ruleset>
